{
	"name": "openworld",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply openworld --local",
		"db:migrate": "wrangler d1 migrations apply openworld --remote"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260930.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.144.0"
	},
	"description": "OpenWorld \u2014 a social network for showing creative work of every kind, from wherever it lives"
}
